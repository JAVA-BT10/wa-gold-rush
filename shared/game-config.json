  "netWorthCalculation": {
    "formula": "Cash + MineValue + EquipmentValue + PersonnelValue + HaulageValue",
    "components": {"cash": "Current available funds", "mineValue": "Sum of all owned mines' base values", "equipmentValue": "Sum of all equipment items' resale values (per mine)", "personnelValue": "Sum of all personnel items' resale values (per mine)", "haulageValue": "Sum of all haulage items' resale values (per mine)"}
  },

